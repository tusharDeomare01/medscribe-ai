# ── Database (Docker Compose) ──────────────────────────────
POSTGRES_USER=medscribe
POSTGRES_PASSWORD=medscribe_secret
POSTGRES_DB=medscribe_ai

# Prisma connection string
# For Docker Compose: postgresql://medscribe:medscribe_secret@db:5432/medscribe_ai
# For local dev:      postgresql://medscribe:medscribe_secret@localhost:5432/medscribe_ai
DATABASE_URL=postgresql://medscribe:medscribe_secret@db:5432/medscribe_ai

# ── Google Gemini API Key (get from https://aistudio.google.com/) ──
GEMINI_API_KEY=your-gemini-api-key-here

# ── JWT Secret (use a random 32+ character string) ─────────
JWT_SECRET=your-jwt-secret-here

# ── App URL ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
